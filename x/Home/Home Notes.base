# Home dashboard: notes. Embedded in [[Home]].

views:
  - type: table
    name: "Inbox"
    filters:
      and:
        - file.inFolder("+ Inbox")
        - file.name != "+ Inbox"
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 15
  - type: table
    name: "Efforts On"
    filters:
      and:
        - file.inFolder("Efforts/On")
        - file.name != "On"
    order:
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 15
  - type: table
    name: "Recent Notes"
    filters:
      and:
        - file.inFolder("Atlas/Notes")
        - file.name != "Notes"
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 10
