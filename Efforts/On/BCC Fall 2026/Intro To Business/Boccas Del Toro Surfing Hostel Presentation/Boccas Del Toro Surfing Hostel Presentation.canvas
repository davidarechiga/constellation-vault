  {
   "id": "n34",
   "type": "text",
   "x": 1922,
   "y": 294,
   "width": 400,
   "height": 78,
   "text": "Dorm/private prices at Bocas hostels\n→ dorm ~$12–20, private ~$40–90"
  },
  {
   "id": "n35",
   "type": "text",
   "x": 1922,
   "y": 384,
   "width": 400,
   "height": 102,
   "text": "Tourist numbers + busiest months\n→ Panama 3M (2025); Bocas 100K+/yr (old); peak Dec–Jan"
  },
  {
   "id": "n36",
   "type": "text",
   "x": 1922,
   "y": 498,
   "width": 400,
   "height": 78,
   "text": "Surf season for main breaks\n→ Dec–Mar main, Jun–Aug mini"
  },
  {
   "id": "n37",
   "type": "text",
   "x": 1922,
   "y": 588,
   "width": 400,
   "height": 102,
   "text": "Hostel occupancy rates (Panama/C. America)\n→ Bocas hotels 70.4% (2026)"
  },
  {
   "id": "n38",
   "type": "text",
   "x": 1922,
   "y": 702,
   "width": 400,
   "height": 102,
   "text": "Foreign business ownership rules, Panama\n→ 100% foreign OK; work permit needed; no retail"
  },
  {
   "id": "n39",
   "type": "text",
   "x": 1922,
   "y": 816,
   "width": 400,
   "height": 102,
   "text": "Rent/property costs in Bocas\n→ operating hostels $375–455K to buy; lease = gap"
  },
  {
   "id": "n40",
   "type": "text",
   "x": 1922,
   "y": 930,
   "width": 400,
   "height": 78,
   "text": "Booking-site commission rates\n→ Hostelworld 15%, Booking ~15%"
  },
